.venv/
.venv-torch/
work/

# Built by build-exe.ps1 from DressStudioSetup.ps1 (which IS committed --
# this is generated output, not source, and an unsigned .exe in git tends to
# get flagged by antivirus/SmartScreen on download regardless of content.
# Build it locally and hand the .exe to a colleague directly (a drive/email/
# chat attachment), not via git.
DressStudioSetup.exe
output/
__pycache__/
*.pyc

# Datasets and anything cut from them. Not ours to redistribute, large, and
# regenerable from the download commands in docs/01-datasets.md.
data/raw/
data/fixtures/
# Real Indian ethnic-wear photos pulled from a Myntra-derived retail dataset for
# testing person-preservation. Same posture as data/fixtures/: local development
# and testing only, never published, never redistributed.
data/ethnic-fixtures/

# The shop's own garment photographs, once they exist. Same reasoning as the
# sibling project: source photography is not pushed to a remote.
data/incoming/

# The operator's own real garment photographs, dropped in for local
# testing (includes iPhone HEIC originals). Private stock photography --
# never committed, never published, same discipline as data/incoming/.
test-images/

# A handful of real photos exported for the operator to hand-upload to a
# third-party service (Claid.ai etc) for evaluation, 2026-09-21. Same
# photos as test-images/, same reason they're not committed.
claid-test-batch/

# Batch logs and comparison sheets. Regenerable; what matters is transcribed
# into TASK.md.
work-reports/

# The operator's own backdrop photos, saved permanently once uploaded
# through the app (2026-09-22) so they persist across runs and restarts.
# Same discipline as test-images/ and data/incoming/ -- private, never
# committed.
data/backdrop_library/
